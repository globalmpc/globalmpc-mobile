# Build-time configuration template.
#
# Copy to env/dev.env or env/prod.env, fill in the values for that deployment,
# and pass the file to every Flutter command that produces a binary:
#
#   flutter run   --dart-define-from-file=env/dev.env
#   flutter build --dart-define-from-file=env/prod.env
#
# The copies are gitignored. Only this template is tracked, and it carries no
# deployment-specific value. A prod build fails at startup when a required
# value is missing, so a mis-targeted binary cannot reach users.

# dev | prod. Selects the default network parameters below and the
# validation rules (a prod build must target chain 56 and needs a token).
MPC_ENV=dev

# Chain the wallet reads from and signs against. dev defaults to 97, prod to 56.
MPC_CHAIN_ID=97
MPC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
MPC_EXPLORER_URL=https://testnet.bscscan.com
MPC_NETWORK_LABEL=BSC Testnet

# ERC-20 token contract on MPC_CHAIN_ID. Required for prod. Leave empty to
# build a wallet that shows no token balance and keeps sending disabled.
MPC_TOKEN_ADDRESS=

# Registry anchor contract on MPC_CHAIN_ID. Optional: leave empty to ship
# without the public registry feed.
MPC_REGISTRY_ANCHOR_ADDRESS=

# Blocks scanned for transfer history. Lower it if the RPC provider rejects
# the default range.
MPC_HISTORY_BLOCK_WINDOW=80000

# External presale website. Optional: leave empty to hide the presale entry.
MPC_PRESALE_URL=

# Legal and help destinations opened from Settings. https only.
MPC_TERMS_URL=https://www.globalmpc.tech/legal/terms-of-use
MPC_PRIVACY_URL=https://www.globalmpc.tech/legal/privacy-policy
MPC_HELP_URL=https://www.globalmpc.tech/

# Store listing for the "Rate us" row. Optional: leave empty until listed.
MPC_STORE_URL=
